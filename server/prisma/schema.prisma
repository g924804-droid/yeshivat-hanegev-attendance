generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Role: מורה | עובד | מנהל — Department: ישיבה קטנה | ישיבה גדולה | תיכון | סמינר | ניהול
// (plain strings — SQLite provider does not support Prisma enums)

model User {
  id                  String   @id @default(cuid())
  name                String
  email               String?
  firstName           String?
  lastName            String?
  role                String // מורה | עובד | מנהל
  department          String?
  // תחום העיסוק שלה בפועל (לא "מחלקה" הכללית) — קודש, אדריכלות, עיצוב מדיה, מזכירות,
  // הנהלת חשבונות, סולם וכו', כדי לדעת בקלות איפה כל עובדת/מורה מועסקת בפועל.
  workArea            String?
  isActive            Boolean  @default(true)
  idNumber            String?
  travelExpenses      Float?
  employmentType      String? // שעתי | חודשי | נגד קבלה
  dailyRequiredHours  Float    @default(8)
  trackLessons        Boolean  @default(false)
  dailyTravelCost     Float?
  monthlyBusPass      Float?
  employeeStatus      String   @default("פעיל")
  sundayHours         Float?
  mondayHours         Float?
  tuesdayHours        Float?
  wednesdayHours      Float?
  thursdayHours       Float?
  fridayHours         Float?
  isAttendanceManager Boolean  @default(false) // הרשאה נוספת (לצד מנהל) לצפות/לאשר את דוחות הנוכחות של כל המורות
  // הרשאה נפרדת מ-isAttendanceManager: לראות ולסמן נוכחות תלמידות בכל המסלולים (לא רק
  // המסלולים המקושרים לשיעורים שלה), בלי לקבל גישה לניהול דוחות נוכחות עובדים/מורות ובלי
  // כפתור "ניהול" בדף הבית — מיועד למזכירה שממלאת נוכחות תלמידות בשביל כמה מסלולים/מורות.
  canManageAllStudentTracks Boolean @default(false)
  noMonthlyReminder   Boolean  @default(false) // לא לשלוח לה את מייל התזכורת החודשית
  // פרטי חשבון להעברה — חובה למי שמגישה קבלה; נשמרים לחודשים הבאים והיא יכולה לעדכן בכל רגע.
  // חשבת השכר רואה אותם במסך הניהול (קבלות ודוחות).
  bankAccountHolder   String?
  bankName            String?
  bankBranch          String?
  bankAccountNumber   String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  attendanceRecords AttendanceRecord[]
  monthlyReports    MonthlyReport[]
  receipts          Receipt[]
  contracts         Contract[]
  sickNoteFiles     SickNoteFile[]
}

model AttendanceRecord {
  id             String   @id @default(cuid())
  employeeId     String
  employee       User     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date           String // YYYY-MM-DD
  clockIn        String?
  clockOut       String?
  clockIn2       String?
  clockOut2      String?
  totalHours     Float    @default(0)
  overtimeHours  Float    @default(0)
  lessonsCount   Int      @default(0)
  type           String   @default("רגיל") // רגיל | מחלה | חופשה שנתית | חופשה אישית | חג | חצי יום
  notes          String?
  sickNoteUrl    String?
  // מורה שמלמדת כמה דברים יכולה לקבל שכר שונה על חלק מהשעות (למשל תפקיד משרדי מול הוראה) —
  // הדגל הזה מפריד את השעות האלה בחישוב החודשי כדי שחשבת שכר לא תצטרך לחפש את זה בהערות.
  hasSpecialRate Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([employeeId, date])
}

// קובץ אישור מחלה שהעובד/ת מעלה. בטבלה נפרדת (ולא עמודה ב-AttendanceRecord) כדי שטעינת הנוכחות
// החודשית לא תמשוך את תוכן הקבצים — רשומת הנוכחות מחזיקה רק את הקישור אליו ב-sickNoteUrl.
model SickNoteFile {
  id         String   @id @default(cuid())
  employeeId String
  employee   User     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  fileData   Bytes
  fileMime   String
  fileName   String
  createdAt  DateTime @default(now())
}

model MonthlyReport {
  id                String   @id @default(cuid())
  employeeId        String
  employee          User     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  month             String // YYYY-MM
  totalWorkDays     Int      @default(0)
  totalHours        Float    @default(0)
  totalOvertime     Float    @default(0)
  sickDays          Int      @default(0)
  vacationDays      Int      @default(0)
  totalLessons      Int      @default(0)
  status            String   @default("טיוטה") // טיוטה | הוגש | אושר
  reminderSent      Boolean  @default(false)
  employeeSignature String?
  pdfUrl            String?
  holidayDays       Int      @default(0)
  absenceHours      Float    @default(0)
  absenceDays       Int      @default(0)
  specialRateHours  Float    @default(0) // תת-קבוצה של totalHours — שעות שסומנו בשכר שונה מהרגיל
  employeeNote      String? // הערה של העובד/ת לחשבת השכר, נכתבת לפני החתימה
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  attachments ReportAttachment[]

  @@unique([employeeId, month])
}

// קובץ שהעובד/ת מצרפ/ת לדוח החודשי לחשבת השכר. בטבלה נפרדת כדי שטעינת הדוחות לא תמשוך את תוכן הקבצים.
model ReportAttachment {
  id        String        @id @default(cuid())
  reportId  String
  report    MonthlyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  fileData  Bytes
  fileMime  String
  fileName  String
  createdAt DateTime      @default(now())

  @@index([reportId])
}

model Receipt {
  id           String   @id @default(cuid())
  description  String
  employeeId   String
  employee     User     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  month        String
  receiptDate  String
  amount       Float
  fileData     Bytes?
  fileMime     String?
  fileName     String?
  status       String   @default("ממתין") // ממתין | אושר | נדחה
  adminNotes   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Contract {
  id                String    @id @default(cuid())
  title             String
  employeeId        String
  employee          User      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  status            String    @default("ממתין לחתימה") // ממתין לחתימה | נחתם | בוטל
  fileData          Bytes?
  fileMime          String?
  fileName          String?
  employeeSignature String?
  signedAt          DateTime?
  uploadedAt        DateTime  @default(now())
  notes             String?
  amount            Float?    // הסכום בחוזה — להצגה ברשימת החוזים
  amountUnit        String?   // לשעה | לשיעור | לחודש | סה"כ
  templateData      Json?     // חוזה שנוצר מתבנית — הנתונים שמולאו, כדי ליצור מחדש את ה-PDF עם החתימה
}

model ScheduleHistory {
  id           String   @id @default(cuid())
  description  String
  changedAt    DateTime @default(now())
  changedBy    String?
  changeType   String?
  lessonId     String?
  trackName    String?
  className    String?
  dayOfWeek    String?
  time         String?
  room         String?
  teacherName  String?
  fromDate     String? // מתי השיעור (בגרסה הזו) נכנס לתוקף
  toDate       String? // מתי הפסיק להיות בתוקף — ריק = עדיין בתוקף
  previousData String? // JSON
}

// ביטול שיעור בתאריך מסוים (המורה לא הגיעה, משתחררות וכו'). שיעור שבוטל מוצג כמבוטל במערכת
// ובמסך התצוגה, ולא נדרשת עליו נוכחות תלמידות מהמורה. השיעור עצמו ב-Airtable לא משתנה.
model LessonCancellation {
  id        String   @id @default(cuid())
  lessonId  String // מזהה השיעור ב-Airtable
  date      String // YYYY-MM-DD
  reason    String?
  createdBy String?
  createdAt DateTime @default(now())

  @@unique([lessonId, date])
  @@index([date])
}

model Announcement {
  id        String   @id @default(cuid())
  text      String? // אפשר גם הודעה עם קובץ בלבד (פוסטר/PDF) בלי טקסט
  fileData  Bytes?
  fileMime  String?
  fileName  String?
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

// שורה יחידה (id קבוע "singleton") — שם המוסד + לוגו למסך התצוגה וכל שאר האתר.
model SiteSettings {
  id       String  @id @default("singleton")
  siteName String?
  logoData Bytes?
  logoMime String?
  // YYYY-MM של הפעם האחרונה ששלחנו תזכורת חודשית — מונע שליחה כפולה אם השרת עולה כמה
  // פעמים ביום האחרון של החודש (למשל אחרי דיפלוי). זו התזכורת האחרונה (ב-30).
  lastReminderMonth String?
  // YYYY-MM של התזכורת המוקדמת (ב-25) — אותו מנגנון, בנפרד
  lastEarlyReminderMonth String?
}

// תשלום בפועל על חודש של תלמידה (רשומה בטבלת התשלומים ב-Airtable). כמה תשלומים לאותו חודש =
// פיצול בין אמצעי תשלום (למשל חצי מזומן וחצי צ'ק) או תשלום בכמה פעמים. הסכום הכולל נכתב ל-Airtable.
model PaymentEntry {
  id          String   @id @default(cuid())
  paymentId   String // מזהה הרשומה ב-Airtable
  studentName String
  month       String // שם החודש בעברית, כמו ב-Airtable
  year        String
  method      String
  amount      Float
  date        String // YYYY-MM-DD
  notes       String?
  createdBy   String?
  createdAt   DateTime @default(now())

  @@index([paymentId])
}

// הגדרות חיוב קבועות לתלמידה — לפי שם, כי טבלת התשלומים ב-Airtable מקושרת לתלמידות רק לפי שם.
model StudentBilling {
  studentName        String  @id
  monthlyAmount      Float   @default(0)
  monthlyScholarship Float   @default(0)
  active             Boolean @default(true) // false = לא ליצור לה יותר חיובים חודשיים (למשל סיימה)
  notes              String?
}

// סכום חודשי לפי מגמה (מסלול ב-Airtable) — כל תלמידה במגמה מחויבת בו, אלא אם הוגדר לה סכום אישי.
model TrackPrice {
  trackId       String @id
  trackName     String
  monthlyAmount Float  @default(0)
}

// שיעור ברוטציה "כל שבועיים" (שבוע מורה א', שבוע מורה ב') — נספר מה"מתאריך" של השיעור.
model LessonRotation {
  lessonId      String   @id
  everyTwoWeeks Boolean  @default(true)
  updatedAt     DateTime @updatedAt
}

// פנקס הוצאות — קטגוריה (גיליון) לשנה, למשל "הרצאות" בתשפ"ז, עם תקציב שנתי.
model ExpenseCategory {
  id        String    @id @default(cuid())
  year      String // שנת לימודים בעברית, למשל תשפ"ז
  name      String
  budget    Float     @default(0)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  expenses  Expense[]
  // קטגוריה שההוצאות שלה יורדות גם מהתקציב של קטגוריית האב (למשל ק"ק פעילות ← פעילות חברתית)
  parentId  String?
  parent    ExpenseCategory?  @relation("ExpenseCategoryParent", fields: [parentId], references: [id], onDelete: SetNull)
  children  ExpenseCategory[] @relation("ExpenseCategoryParent")

  @@unique([year, name])
}

model Expense {
  id             String          @id @default(cuid())
  categoryId     String
  category       ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  date           String // YYYY-MM-DD, או ריק אם באקסל היה רק תאריך עברי
  hebrewDate     String? // תאריך עברי כפי שנכתב — רק כשאין תאריך לועזי (אחרת מחושב)
  topic          String? // "נושא הפעילות" (מפגש אלולי, כנס פתיחה...) — כמה שורות לאותה פעילות
  sortOrder      Float           @default(0) // סדר השורות כמו בגיליון
  payee          String // שם בקבלה / שם הרב (יכול להיות ריק)
  invoiceText    String? // חשבונית כקישור (למשל לקובץ ב-Google Drive מהאקסל)
  invoiceUrl     String?
  receiptText    String?
  receiptUrl     String?
  details        String?
  paymentMethod  String?
  amount         Float?
  accountDetails String?
  paymentDate    String? // תאריך התשלום, YYYY-MM-DD
  notes          String?
  createdBy      String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  files          ExpenseFile[]

  @@index([categoryId])
}

// קובץ חשבונית או קבלה של הוצאה — נשמר ב-DB (מערכת הקבצים ב-Render לא קבועה).
model ExpenseFile {
  id        String   @id @default(cuid())
  expenseId String
  expense   Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  kind      String // invoice | receipt
  fileData  Bytes
  fileMime  String
  fileName  String
  createdAt DateTime @default(now())

  @@index([expenseId])
}
